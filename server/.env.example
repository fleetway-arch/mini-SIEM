# Copy to server/.env for local development (never commit the real file).

# development | production | test
APP_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=siem

# Comma-separated list of frontend origins allowed by CORS (no "*").
CORS_ALLOWED_ORIGINS=http://localhost:5173

# REQUIRED. At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime and refresh token lifetime (Go durations).
JWT_TTL=15m
REFRESH_TTL=168h

# The refresh cookie is Secure by default. Set false only for plain-http
# local development; it is refused when APP_ENV=production.
COOKIE_SECURE=false
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Rate limits for login, signup and refresh (per window).
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTH_PER_IP=20
RATE_LIMIT_AUTH_PER_EMAIL=5

# Public URL of the frontend, used to build invitation and reset links.
# Must be https when APP_ENV=production.
APP_BASE_URL=http://localhost:5173

# SMTP. Leave SMTP_HOST empty to only log emails (links are printed in
# development only). Local Mailpit: SMTP_HOST=localhost SMTP_PORT=1025
# SMTP_REQUIRE_TLS=false. STARTTLS is required by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
MAIL_FROM=Mini SIEM <no-reply@example.com>
