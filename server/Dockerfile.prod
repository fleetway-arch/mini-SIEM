# Production image: compiled static binary on a minimal, non-root base.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/siem-api ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/siem-api /siem-api
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/siem-api"]
