# Production image: built static frontend served by nginx over HTTPS, which
# also proxies /api to the Go API so everything is same-origin.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
RUN apk add --no-cache openssl
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/self-signed-cert.sh /docker-entrypoint.d/05-self-signed-cert.sh
RUN chmod +x /docker-entrypoint.d/05-self-signed-cert.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 443
