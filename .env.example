# Base URL de l'API REST (backend Go)
VITE_API_URL=http://localhost:8080

# Used by docker compose only (never exposed to the browser: no VITE_ prefix).
# REQUIRED, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Production stack only (docker-compose.prod.yml). REQUIRED there.
# Generate with: openssl rand -hex 24
MONGO_ROOT_PASSWORD=
# Public HTTPS URL of the app (default https://localhost:8443) and real SMTP.
# PUBLIC_URL=https://siem.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Mini SIEM <no-reply@example.com>
# Optional ingestion and detection tuning (defaults shown).
# RATE_LIMIT_INGEST_PER_KEY=600
# DETECT_BRUTE_FORCE_THRESHOLD=10
# DETECT_BRUTE_FORCE_WINDOW=5m
